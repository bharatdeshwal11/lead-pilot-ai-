FROM node:24-alpine AS frontend
WORKDIR /web
COPY frontend/ ./
RUN npm ci && npm run build && rm -rf node_modules /root/.npm

FROM eclipse-temurin:21-jdk-alpine AS backend
WORKDIR /app
COPY backend/ ./
COPY --from=frontend /web/dist/ src/main/resources/static/
RUN ./mvnw -B -ntp -Dmaven.test.skip=true package && rm -rf /root/.m2

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN chmod 755 /app && addgroup -S leadpilot && adduser -S -G leadpilot leadpilot
COPY --chmod=444 --from=backend /app/target/leadpilot-api-1.0.0.jar app.jar
COPY --chmod=755 deployment/start.sh start.sh
USER leadpilot
EXPOSE 8080
ENTRYPOINT ["/app/start.sh"]
