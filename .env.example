APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

APP_OPENAPI_ENABLED=true
APP_LOGIN_LIMIT=12
APP_AI_LIMIT=12
